# Firebase web config for Google sign-in + cloud sync (optional).
# Copy to .env.local and fill in. With these empty, the Account section is hidden
# and Flipwise runs local-only exactly as before.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to talk to local Firebase emulators (auth :9099, firestore :8080)
# instead of the real project. Never enabled by default.
VITE_FIREBASE_EMULATOR=
